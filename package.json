{
  "name": "cyberstition-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "npm run dev",
    "dev:app": "npm run dev",
    "build": "tsc -b && vite build",
    "build:web": "npm run build",
    "build:app": "npm run build",
    "preview": "vite preview",
    "preview:web": "npm run preview",
    "preview:app": "npm run preview",
    "postinstall": "node -e \"const fs=require('fs');const prefs='connection.project.dir=\\neclipse.preferences.version=1\\n';['node_modules/@capacitor/android/capacitor','node_modules/@capacitor/app/android','node_modules/@capacitor/splash-screen/android','node_modules/@capacitor/status-bar/android'].forEach(p=>{const d=p+'/.settings';fs.mkdirSync(d,{recursive:true});fs.writeFileSync(d+'/org.eclipse.buildship.core.prefs',prefs);});\""
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "lucide-react": "^0.542.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^7.0.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
